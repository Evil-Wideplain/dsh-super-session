{
  "name": "@local/dsh-personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "Three agent presets for DeepSeek Harness: a shell-first personal assistant, a worker preset for briefed, verified delegation, and a coordinator that dispatches workers for one goal; memory comes from the profile memory plugin.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./context.js": "./context.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./guard.js": "./guard.js",
    "./team.js": "./team.js"
  },
  "files": [
    "index.js",
    "context.js",
    "client.js",
    "scripts",
    "cordis.patch.yml",
    "prompt",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "icon.svg",
    "README.md",
    "guard.js",
    "team.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
