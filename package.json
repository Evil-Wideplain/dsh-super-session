{
  "name": "@local/dsh-personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "context.js",
  "description": "Two agent presets for DeepSeek Harness: a shell-first personal assistant (persistent shell, web, Office, goals, schedules) and a worker preset for briefed, verified delegation; memory comes from the profile's memory plugin.",
  "license": "MIT",
  "exports": {
    ".": "./context.js",
    "./super-session": "./super-session.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "context.js",
    "client.js",
    "super-session.js",
    "scripts",
    "cordis.patch.yml",
    "prompt",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
